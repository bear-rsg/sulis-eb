easyblock = 'CMakeNinja'

name = 'Qt6'
version = '6.6.3'

homepage = 'https://qt.io/'
description = "Qt is a comprehensive cross-platform C++ application framework."

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}
# disabling use of -ftree-vectorize is required to avoid compilation failures on some systems (e.g. Intel Skylake X)
toolchainopts = {'vectorize': False}

source_urls = [
    'https://download.qt.io/official_releases/qt/%(version_major_minor)s/%(version)s/single/',
    'https://download.qt.io/archive/qt/%(version_major_minor)s/%(version)s/single/',
    'https://download.qt.io/new_archive/qt/%(version_major_minor)s/%(version)s/single/',
]
sources = ['qt-everywhere-src-%(version)s.tar.xz']
checksums = ['0e2c9dd87cbc6768da2bfc7f776c272f']

builddependencies = [
    ('binutils', '2.40'),
    ('pkgconf', '2.0.3'),
    ('CMake', '3.27.6'),
    ('Ninja', '1.11.1'),
    # deps for QtWebEngine
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
    ('gperf', '3.1'),
    ('re2c', '3.1'),
]

dependencies = [
    ('double-conversion', '3.3.0'),
    ('GLib', '2.78.1'),
    ('PCRE2', '10.42'),
    ('libpng', '1.6.40'),
    ('LibTIFF', '4.6.0'),
    ('libwebp', '1.3.2'),
    ('JasPer', '4.0.0'),
    ('HarfBuzz', '8.2.2'),
    ('SQLite', '3.43.1'),
    ('graphite2', '1.3.14'),
    ('X11', '20231019'),
    ('fontconfig', '2.14.2'),
    ('Python', '3.11.5'),
    ('Python-bundle-PyPI', '2023.10'),  # WebEngine
    ('freetype', '2.13.2'),  # WebEngine
    ('libevent', '2.1.12'),  # WebEngine
    ('libGLU', '9.0.3'),
    ('libjpeg-turbo', '3.0.1'),  # WebEngine
    ('DBus', '1.15.8'),
    ('ICU', '74.1'),  # WebEngine, optional
    ('OpenSSL', '1.1', '', SYSTEM),
    ('bzip2', '1.0.8'),
]

# See qtbase/cmake/configure-cmake-mapping.md for options
configopts = '-DQT_QMAKE_TARGET_MKSPEC=linux-g++'
configopts += ' -DQT_AVOID_CMAKE_ARCHIVING_API=ON'

sanity_check_paths = {
    'files': [
        'lib64/libQt6Gui.%s' % SHLIB_EXT,
        'lib64/libQt6Widgets.%s' % SHLIB_EXT,
    ],
    'dirs': ['include/QtGui', 'include/QtWidgets'],
}

moduleclass = 'devel'